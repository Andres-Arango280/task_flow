{
  "name": "taskflow-e2e-screenplay",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas E2E de TaskFlow con el patrón Screenplay (Serenity/JS + Playwright Test) y escenarios Gherkin (Cucumber + Serenity/JS)",
  "scripts": {
    "test": "npm run clean && node scripts/ejecutar.mjs",
    "test:headed": "playwright test --headed --workers=1",
    "report": "serenity-bdd run --features ./specs --project \"TaskFlow E2E Screenplay\" && node scripts/generar-resumen.mjs",
    "report:playwright": "playwright show-report reportes/playwright-html",
    "clean": "rimraf target reportes test-results",
    "typecheck": "tsc -p .",
    "gherkin": "node scripts/ejecutar-gherkin.mjs",
    "gherkin:solo": "cucumber-js",
    "gherkin:resumen": "node scripts/generar-resumen-gherkin.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "1.63.0",
    "@serenity-js/assertions": "3.48.2",
    "@serenity-js/console-reporter": "3.48.2",
    "@serenity-js/core": "3.48.2",
    "@serenity-js/cucumber": "^3.48.2",
    "@serenity-js/playwright": "3.48.2",
    "@serenity-js/playwright-test": "3.48.2",
    "@serenity-js/rest": "3.48.2",
    "@serenity-js/serenity-bdd": "3.48.2",
    "@serenity-js/web": "3.48.2",
    "@types/node": "26.6.4",
    "rimraf": "6.1.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
