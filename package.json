{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "API para gestión de tareas colaborativas",
  "author": "Estudiante",
  "license": "MIT",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "test": "jest --selectProjects unit --runInBand",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:unit:auth": "jest --selectProjects unit-auth --runInBand",
    "test:unit:equipos": "jest --selectProjects unit-equipos --runInBand",
    "test:unit:proyectos": "jest --selectProjects unit-proyectos --runInBand",
    "test:unit:listas": "jest --selectProjects unit-listas --runInBand",
    "test:unit:tareas": "jest --selectProjects unit-tareas --runInBand",
    "test:unit:usuarios": "jest --selectProjects unit-usuarios --runInBand",
    "test:e2e:auth": "jest --selectProjects e2e-auth --runInBand",
    "test:e2e:equipos": "jest --selectProjects e2e-equipos --runInBand",
    "test:e2e:proyectos": "jest --selectProjects e2e-proyectos --runInBand",
    "test:e2e:listas": "jest --selectProjects e2e-listas --runInBand",
    "test:e2e:tareas": "jest --selectProjects e2e-tareas --runInBand",
    "test:e2e:usuarios": "jest --selectProjects e2e-usuarios --runInBand",
    "test:regression:unit": "jest --selectProjects unit --runInBand",
    "test:regression:e2e": "jest --selectProjects e2e --runInBand",
    "test:regression": "npm run test:regression:unit && npm run test:regression:e2e",
    "test:cov": "jest --selectProjects unit --coverage --runInBand",
    "test:cov:e2e": "jest --selectProjects e2e --coverage --runInBand",
    "sonar:install": "npm install -g sonarqube-scanner",
    "sonar:analyze": "sonar-scanner",
    "sonar:docker": "docker run -d --name sonarqube -e SONAR_JDBC_URL=jdbc:h2:tcp://localhost:9092/sonarqube -e SONAR_JDBC_USER=sa -e SONAR_JDBC_PASSWORD= -v sonarqube_data:/opt/sonarqube/data -v sonarqube_extensions:/opt/sonarqube/extensions -v sonarqube_logs:/opt/sonarqube/logs -p 9000:9000 sonarqube:latest",
    "test:evidencias": "jest --selectProjects unit --coverage --coverageReporters=json-summary --coverageReporters=html --coverageReporters=text-summary --coverageDirectory=pruebas/evidencias/backend-jest/cobertura --runInBand --json --outputFile=pruebas/evidencias/backend-jest/jest-unit.json && jest --selectProjects e2e --runInBand --json --outputFile=pruebas/evidencias/backend-jest/jest-e2e.json && node pruebas/jest-a-resumen.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.1.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.13",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.9",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
